# Copier en .env pour le dev local (docker compose up -d). En prod : ConfigMap + Secret OpenShift.

DATABASE_URL=postgres://jq:jq@localhost:5433/jq
# URL publique de l'app, sans / final. Redirect URI à déclarer chez l'IdP : <ORIGIN>/auth/callback
ORIGIN=http://localhost:5173

# Fournisseur OIDC générique (Entra ID, Keycloak, GitLab…).
# Entra : https://login.microsoftonline.com/<tenant-id>/v2.0 (URL par tenant, pas /common).
OIDC_ISSUER_URL=http://localhost:8080/jq
OIDC_CLIENT_ID=jingle-quest
OIDC_CLIENT_SECRET=dev-secret

# Optionnel : restreint aux domaines listés (séparés par des virgules). Vide = tout compte de l'IdP.
ALLOWED_EMAIL_DOMAINS=
# Comptes admin (emails séparés par des virgules).
ADMIN_EMAILS=admin@exemple.com

# Optionnel (lot 5) : notifications push. Générer avec `npx web-push generate-vapid-keys`.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@exemple.com
